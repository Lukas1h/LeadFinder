# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel — project.json carries no secrets (just projectId/orgId), and
# committing it lets a fresh session's `vercel env pull` find the right
# project without an interactive `vercel link` step first.
.vercel/*
!.vercel/project.json

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
