# Copy to .env.local and fill in for local dev.
# In Vercel, set these under Project Settings > Environment Variables instead.

# Server-side only. Never prefix with NEXT_PUBLIC_.
ZILLAPI_KEY=zk_...

# For AI message drafting (OpenAI). Server-side only.
OPENAI_API_KEY=sk-proj-...

# For AI photo scoring (Gemini 3.5 Flash-Lite vision). From aistudio.google.com.
# Server-side only.
GEMINI_API_KEY=AIza...

# From the Neon integration (Vercel Marketplace) or your own Neon project.
DATABASE_URL=postgres://...

# From the AgentMail integration (Vercel Marketplace) — provisions a
# standalone inbox for ingesting Zillow email alerts, no personal email
# connected. See src/app/api/webhooks/agentmail/route.ts.
AGENTMAIL_API_KEY=am_...
# Signing secret for the AgentMail webhook subscription (Svix-based) — set
# up the webhook in the AgentMail dashboard pointing at
# /api/webhooks/agentmail, then copy its secret here.
AGENTMAIL_WEBHOOK_SECRET=whsec_...

# Web Push (VAPID) for iOS/desktop notifications when new leads come in —
# generate a pair with `npx web-push generate-vapid-keys`. The public key is
# meant to be public (sent to the browser to subscribe); the private key
# signs outgoing pushes and must stay server-side only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...

# Any string works locally. In Vercel, this is set automatically by the
# platform when the integration is enabled — copy that value here if you
# want to hit the route manually with a matching Authorization header.
CRON_SECRET=dev-secret

# Gates POST/GET /api/import-listing (single-listing import from a Zillow
# URL, used by the iOS share-sheet Shortcut — see README). Any string works;
# this one isn't set by any platform integration, pick your own and put the
# same value in the Shortcut. Not needed for the in-app Import button, which
# calls a server action instead of this route.
IMPORT_SHARE_SECRET=dev-import-secret

# Search areas (bbox + price/home-type filters) are managed on the
# Settings page in the app now, stored in the search_sources table — not
# env vars. Add your first source there after running db:push.

# Set to "true" to read from data/mock-listings.json instead of calling the
# real Zillapi API — use this for all local dev after your first real call.
USE_MOCK_ZILLAPI=true

# Set to "true" to skip the real OpenAI message-draft call and return a
# canned draft — cheap, but no reason to spend anything during local
# dev/testing.
USE_MOCK_OPENAI=true

# Set to "true" to skip the real Gemini vision call and return a canned
# photo score — same reasoning as USE_MOCK_OPENAI above.
USE_MOCK_GEMINI=true
