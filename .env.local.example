# Copy to .env.local and fill in for local dev.
# In Vercel, set these under Project Settings > Environment Variables instead.

# Server-side only. Never prefix with NEXT_PUBLIC_.
ZILLAPI_KEY=zk_...

# For AI photo scoring (gpt-4o-mini vision). Server-side only.
OPENAI_API_KEY=sk-proj-...

# From the Neon integration (Vercel Marketplace) or your own Neon project.
DATABASE_URL=postgres://...

# Any string works locally. In Vercel, this is set automatically by the
# platform when the integration is enabled — copy that value here if you
# want to hit the route manually with a matching Authorization header.
CRON_SECRET=dev-secret

# west,south,east,north (decimal lon/lat)
SEARCH_BBOX=-123.588360,43.640017,-122.616083,44.349571

# Optional filters, all optional.
SEARCH_PRICE_MIN=440000
SEARCH_HOME_TYPES=house,condo,townhouse
# SEARCH_PRICE_MAX=

# Set to "true" to read from data/mock-listings.json instead of calling the
# real Zillapi API — use this for all local dev after your first real call.
USE_MOCK_ZILLAPI=true

# Set to "true" to skip the real OpenAI vision call and return a canned
# score — OpenAI photo scoring is cheap, but no reason to spend anything
# during local dev/testing.
USE_MOCK_OPENAI=true
