// Copy to Secrets.xcconfig and fill in. Secrets.xcconfig is git-ignored.
// The secret reaches the app as the Info.plist key MOBILE_API_SECRET, which is
// what lets the Call Directory extension (Phase 4) authenticate without App Groups.
//
// Regenerate the project after editing: ./generate.sh
MOBILE_API_SECRET = paste-the-value-of-MOBILE_API_SECRET-from-.env.local-here